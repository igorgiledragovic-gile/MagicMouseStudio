# Windows scripts must keep CRLF line endings (cmd.exe misreads LF-only batch files)
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.iss   text eol=crlf
*.isl   text eol=crlf

*.py    text eol=lf
*.c     text
*.h     text
*.md    text
*.json  text
*.txt   text

*.dll   binary
*.ico   binary
*.png   binary
